[
 {
  "id": "dlg_orvin",
  "start": "start",
  "nodes": {
   "start": {
    "text": "Капитан порта Орвин: Если вернулся с дороги, начни с того, чего не видно с причала.",
    "choices": [
     {
      "offer_quests": true
     },
     {
      "turn_in_quests": true
     },
     {
      "text": "Расскажи о себе",
      "next": "about"
     },
     {
      "text": "Городские службы",
      "do": {
       "service": "town_directory"
      },
      "end": true
     },
     {
      "text": "Зачем следить за обозами?",
      "next": "local_topic"
     },
     {
      "text": "Как изменилась дорога?",
      "next": "road_open",
      "requires": {
       "quest": {
        "id": "m15_lit_beacons",
        "state": "done"
       }
      }
     },
     {
      "text": "На паром к Оазису Мираж",
      "do": {
       "service": "sea_ferry"
