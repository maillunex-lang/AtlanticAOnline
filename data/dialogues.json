     {
      "text": "До встречи",
      "end": true
     }
    ]
   },
   "local_topic": {
    "text": "Белую я даю возчикам. Серую оставляю дозору, чтобы никто не принял наш план за обещание.",
    "choices": [
     {
      "text": "Назад",
      "next": "start"
     },
     {
      "text": "До встречи",
      "end": true
     }
    ]
   }
  }
 },
 {
