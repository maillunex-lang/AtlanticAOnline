   "local_topic": {
    "text": "Кто идёт с холмов, проверяет, горит ли свет за моей дверью. Кто идёт на холмы, проверяет, горит ли свет на мачтах.",
    "choices": [
     {
      "text": "Назад",
      "next": "start"
     },
     {
      "text": "До встречи",
      "end": true
     }
    ]
   }
  }
 },
 {
