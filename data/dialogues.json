[
 {
  "id": "dlg_orvin",
  "start": "start",
  "nodes": {
   "start": {
    "text": "Капитан порта Орвин: Южный рейс отходит с деревянного пирса за моей спиной. Если вернулся с тракта, расскажи, что видел по дороге.",
