   "road_open": {
    "text": "Белая карта снова висит над столом. На серой осталась одна запись: проверить настил после первого сильного дождя.",
    "choices": [
     {
      "text": "Назад",
      "next": "start"
     },
     {
      "text": "До встречи",
      "end": true
